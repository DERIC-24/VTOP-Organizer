
{
  "manifest_version": 3,
  "name": "VTOP Organizer",
  "version": "0.1.0",
  "description": "Organize and download VTOP course materials.",

  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://vtop.vit.ac.in/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://vtop.vit.ac.in/*"
      ],
      "js": [
        "content/main-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vtop.vit.ac.in/*"
      ],
      "js": [
        "content/course-parser.js",
        "content/vtop-detector.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "action": {
    "default_title": "Open VTOP Organizer"
  }
}
